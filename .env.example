# Don't fill this in by hand: run `npm run env` after `npx supabase start`.
# It writes .env.local from `npx supabase status` (local-development values only).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<from npx supabase status>
# Test suite only (creates throwaway users). Never used by the app.
SUPABASE_SECRET_KEY=<from npx supabase status>
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
